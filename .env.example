# Copy this file to .env.local and fill in the values.
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated Google account emails allowed to use the app (the 3 of you).
ALLOWED_EMAILS=jwmilius@gmail.com,friend2@gmail.com,friend3@gmail.com

# --- MCP server only (mcp/) — lets Claude drive the hub. See mcp/README.md ---
# Service role key (Supabase -> Settings -> API). SECRET: local machines only.
SUPABASE_SERVICE_ROLE_KEY=
# Whose actions Claude performs on this machine (your own email).
BRAIN_ACTOR_EMAIL=yourEamil@email.com
