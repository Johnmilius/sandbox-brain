# Copy this file to .env.local and fill in the values.
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Comma-separated Google account emails allowed to use the app (the 3 of you).
ALLOWED_EMAILS=jwmilius@gmail.com,friend2@gmail.com,friend3@gmail.com

# --- MCP server only (mcp/) — lets Claude drive the hub. See mcp/README.md ---
# Preferred: per-user auth. Keeps row-level security on and is revocable per
# person. Grab your token from the web app (Profile -> MCP access). The server
# keeps it rotated for you (it uses NEXT_PUBLIC_SUPABASE_ANON_KEY above).
BRAIN_USER_REFRESH_TOKEN=

# Legacy fallback only — bypasses row-level security; avoid for new setups.
# If BRAIN_USER_REFRESH_TOKEN is set, these are ignored.
#   SUPABASE_SERVICE_ROLE_KEY=   # Supabase -> Settings -> API. SECRET, local only.
#   BRAIN_ACTOR_EMAIL=you@gmail.com
