# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
mcp/node_modules
mcp/dist
packages/*/node_modules
packages/*/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS app (Xcode/SwiftPM local state — real source lives on feature/macos-app,
# but this can show up locally regardless of which branch is checked out)
macos-app/.swiftpm/
macos-app/.build/
macos-app/build/
*.xcuserstate

# graphify (local dev tool: knowledge graph for AI assistants — not part of the app)
graphify-out/
.graphifyignore
.graphify_version
/raw/
# only created if graphify is installed with --project scope
.claude/skills/graphify/
.claude/CLAUDE.md
.claude/settings.json
